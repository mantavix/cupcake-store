{
    "name": "cupcake-store/app",
    "description": "Cupcake Store - Loja Online de Cupcakes",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-session": "*"
    },
    "scripts": {
        "post-install-cmd": [
            "php install/setup_database.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}